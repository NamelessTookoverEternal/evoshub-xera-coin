{
  "name": "xera-bnb-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "XERA settlement/ownership layer on BNB Smart Chain (XeraToken, XeraMiningDistributor, XeraVesting, XeraMigrationClaim)",
  "scripts": {
    "compile": "hardhat compile",
    "compile:offline": "node tools/verify_compile_offline.js",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "deploy:testnet": "hardhat run scripts/deploy.js --network bscTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network bscMainnet"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "hardhat": "^2.22.0",
    "solc": "^0.8.24"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "dotenv": "^16.4.5"
  }
}
