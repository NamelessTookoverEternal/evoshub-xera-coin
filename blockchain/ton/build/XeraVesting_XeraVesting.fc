((slice, cell, slice, int, slice, int, int, cell, cell), ()) $XeraVesting$_fun_notify((slice, cell, slice, int, slice, int, int, cell, cell) $self, cell $body) impure inline {
    var (($self'minter, $self'jettonWalletCode, $self'distributorOwnerAddress, $self'distributorWalletConfigured, $self'admin, $self'vestingDuration, $self'paused, $self'tranches, $self'userLockedTotal)) = $self;
