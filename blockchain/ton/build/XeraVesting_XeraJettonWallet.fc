        throw_unless(29707, ( (( equal_slices_bits($ctx'sender, $self'minter) )) ? (true) : (($self'balance, $self'owner, $self'minter, $self'jettonWalletCode)~$XeraJettonWallet$_fun_isValidWalletSender($ctx'sender, $msg'sender)) ));
        $self'balance = ($self'balance + $msg'amount);
