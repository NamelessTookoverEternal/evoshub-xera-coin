;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'minter, $self'jettonWalletCode, $self'vesting, $self'signerPublicKey, $self'admin, $self'maxAllocation, $self'totalDistributed, $self'paused, $self'consumed) = $XeraMiningDistributor$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for JettonTransfer message
        if (op == 0xf8a7ea5) {
            var ($msg'queryId, $msg'amount) = in_msg~$JettonTransfer$_load_bounced();
            $self'totalDistributed = ($self'totalDistributed - $msg'amount);
            $XeraMiningDistributor$_contract_store(($self'minter, $self'jettonWalletCode, $self'vesting, $self'signerPublicKey, $self'admin, $self'maxAllocation, $self'totalDistributed, $self'paused, $self'consumed));
            return ();
        }
        
        return ();
    }
    var op = in_msg~load_opcode_internal();
    ;; Receive Claim message
    if (op == 0x2000) {
        var $msg'queryId = in_msg~load_uint(64);
        var $msg'data = in_msg~load_ref();
        var $msg'signature = in_msg;
        throw_unless(51332, (~ $self'paused));
        slice $ds = $Cell$_fun_beginParse($msg'data);
        slice $user = $ds~$Slice$_fun_loadAddress();
        int $amount = $ds~$Slice$_fun_loadCoins();
        int $referenceId = $ds~load_uint(256);
        int $deadline = $ds~load_uint(64);
        throw_unless(23160, ($global_now() <= $deadline));
        throw_unless(31814, null?(__tact_dict_get_int_int($self'consumed, 257, $referenceId, 1)));
        throw_unless(15577, ($amount > 0));
        throw_unless(61156, (($self'totalDistributed + $amount) <= $self'maxAllocation));
        cell $payload = $Builder$_fun_endCell(store_uint(store_uint($Builder$_fun_storeCoins($Builder$_fun_storeAddress(store_uint(store_uint($global_beginCell(), 8192, 32), $msg'queryId, 64), $user), $amount), $referenceId, 256), $deadline, 64));
        throw_unless(54449, $global_checkSignature($Cell$_fun_hash($payload), $msg'signature, $self'signerPublicKey));
        $self'consumed~__tact_dict_set_int_int(257, $referenceId, true, 1);
        $self'totalDistributed = ($self'totalDistributed + $amount);
        int $transferable = (($amount * 2500) / 10000);
        int $locked = ($amount - $transferable);
        slice $myWallet = ($self'minter, $self'jettonWalletCode, $self'vesting, $self'signerPublicKey, $self'admin, $self'maxAllocation, $self'totalDistributed, $self'paused, $self'consumed)~$XeraMiningDistributor$_fun_ownJettonWallet();
        throw_unless(63486, ($Context$_get_value(__tact_context_get()) >= ($self'minter, $self'jettonWalletCode, $self'vesting, $self'signerPublicKey, $self'admin, $self'maxAllocation, $self'totalDistributed, $self'paused, $self'consumed)~$XeraMiningDistributor$_fun_claimGasRequirement()));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($myWallet, 100000000, 1, true, $JettonTransfer$_store_cell($JettonTransfer$_constructor_queryId_amount_destination_responseDestination_customPayload_forwardTonAmount_forwardPayload($msg'queryId, $transferable, $user, null(), null(), 10000000, $global_emptySlice()), begin_cell())));
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($myWallet, 150000000, 1, true, $JettonTransfer$_store_cell($JettonTransfer$_constructor_queryId_amount_destination_responseDestination_customPayload_forwardTonAmount_forwardPayload($msg'queryId, $locked, $self'vesting, null(), null(), 20000000, $Builder$_fun_asSlice(store_uint($Builder$_fun_storeAddress($global_beginCell(), $user), $referenceId, 256))), begin_cell())));
        $XeraMiningDistributor$_contract_store(($self'minter, $self'jettonWalletCode, $self'vesting, $self'signerPublicKey, $self'admin, $self'maxAllocation, $self'totalDistributed, $self'paused, $self'consumed));
        return ();
    }
    
    ;; Receive RotateSigner message
    if (op == 0x2001) {
        var $msg'newSigner = in_msg~load_uint(256);
        var ($ctx'bounceable, $ctx'sender, $ctx'value, $ctx'raw) = __tact_context_get();
        throw_unless(56540, ( equal_slices_bits($ctx'sender, $self'admin) ));
